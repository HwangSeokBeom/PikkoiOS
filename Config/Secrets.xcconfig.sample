PIKKO_BASE_URL = REPLACE_WITH_PIKKO_BASE_URL
PIKKO_SESAC_KEY = REPLACE_WITH_SESAC_KEY
KAKAO_NATIVE_APP_KEY = REPLACE_WITH_KAKAO_NATIVE_APP_KEY
GOOGLE_IOS_CLIENT_ID = REPLACE_WITH_GOOGLE_IOS_CLIENT_ID
GOOGLE_REVERSED_CLIENT_ID = REPLACE_WITH_GOOGLE_REVERSED_CLIENT_ID
PIKKO_INTERNAL_STUB_AUTH_ENABLED = NO
PIKKO_CHAT_SOCKET_DEBUG_ENABLED = NO

// PORTONE_USER_CODE is the PortOne merchant identifier issued in the PortOne console.
// It usually starts with "imp".
// Example: imp12345678
// Write real values only in Config/Secrets.xcconfig and never commit them to git.
// Keep Config/Secrets.xcconfig.sample with placeholders only.
// iamport_ios uses PORTONE_USER_CODE as the required merchant identifier.
// PORTONE_CHANNEL_KEY is not used by the current iamport_ios integration.
PORTONE_USER_CODE = REPLACE_WITH_PORTONE_USER_CODE
PORTONE_APP_SCHEME = pikko
PORTONE_PG = html5_inicis
PORTONE_PG_ID =
PORTONE_PAY_METHOD = card
PAYMENT_TEST_MODE = YES
